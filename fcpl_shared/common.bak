import time
import unicodedata
from typing import NamedTuple


# Unicode normalization helpers

def unicode_normalize(s):
    s = unicodedata.normalize("NFD", s)
    s = s.casefold()
    return unicodedata.normalize("NFD", s)


def unicode_collapse(s: str) -> str:
    """Returns s with accents removed and case folded, in canonical (NFC) form,
    so strings that differ only in accents, case, or precomposed versus
    decomposed characters compare equal.

    Note: only characters that decompose into a base letter plus combining marks
    are affected.  Letters such as 'ø', 'đ' and 'ł' have no such decomposition
    and are left alone."""
    s = unicodedata.normalize("NFD", s)
    s = s.casefold()
    # casefold can introduce new combining marks (e.g. 'İ' -> 'i' + U+0307),
    # so decompose again before stripping them.
    s = unicodedata.normalize("NFD", s)
    s = "".join(c for c in s if not unicodedata.combining(c))
    return unicodedata.normalize("NFC", s)

class ListItem(NamedTuple):
    item_id: str
    short_title: str = "Dummy Title"
    short_author: str = "Dummy Author"
    pub_date: str = "0000"
    format: str = ""

    @classmethod
    def from_resource(cls, resource):
        # Extract fields from resource and return instance
        return cls(
            item_id=resource['id'],
            short_title=resource.get("shortTitle", "Missing Title"),
            short_author=resource.get("shortAuthor", "Missing Author"),
            pub_date=pub_date(resource),
            format=resource.get("format", ""),
        )

    def __str__(self):
        return f"({self.item_id}) {self.short_title} by {self.short_author} ({self.pub_date}) ({self.format})"

class ListInfo(NamedTuple):
    list_name: str
    list_id: str
    list_size: int

    def __str__(self):
        return f"{self.list_name} ({self.list_id}) {self.list_size} items"


_local_branch_name = "C. Burr Artz"    # fixed for now

class AvailabilitySummary(NamedTuple):
    local_avail: int = 0
    local_total: int = 0
    other_avail: int = 0
    other_total: int = 0

    @classmethod
    def from_resource(cls, resource):
        if (holdings := resource.get('holdingsInformations')):
            local_avail = local_total = other_avail = other_total = 0
            for h in holdings:
                if h['branchName'] == _local_branch_name:
                    if h['onshelf']:
                        local_avail += 1
                    local_total += 1
                else:
                    if h['onshelf']:
                        other_avail += 1
                    other_total += 1
            return cls(local_avail, local_total, other_avail, other_total)
        else:
            return None

    def __str__(self):
        return f"{_local_branch_name}: {self.local_avail}/{self.local_total}, Other: {self.other_avail}/{self.other_total}"


class EresourceAvailability(NamedTuple):
    copies_owned: int = 0
    copies_available: int = 0
    number_of_holds: int = 0

    @classmethod
    def from_response(cls, response):
        av = response[0]['availabilitySources'][0]
        return cls(
            copies_owned=av['copiesOwned'],
            copies_available=av['copiesAvailable'],
            number_of_holds=av['numberOfHolds']
            )

    def __str__(self):
        return f"Owned: {self.copies_owned}, Available: {self.copies_available}, Holds: {self.number_of_holds}"


HITS_PER_PAGE = 20
DELAY = 5
HTTP_HEADERS = {
    'Host': 'catalog.fcpl.org',
    'Accept': 'application/json, text/javascript, */*; q=0.01',
    'Connection': 'close',
    'Content-Type': 'application/json; charset=UTF-8'
}
FACET_FILTERS = {
    'Book': {
        "facetDisplay": "Book",
        "facetValue": "Book",
        "facetName": "Format"
        },
    'LastTwoWeeks': {
        "facetDisplay": "Last Two Weeks",
        "facetValue": "LastTwoWeeks",
        "facetName": "DateAddedToSystem"
        }
}

def pub_date(raw_item):
    # Yes, we want raw_item["publicationDate"]["publicationDate"]
    embedded_dict = raw_item.get("publicationDate", {})
    return embedded_dict.get("publicationDate", "0000")

def delete_list_item(s, list_info, list_item):
    # print(f"Deleting item {list_item} from list {list_info}")
    url = f"https://catalog.fcpl.org/list/static/{list_info.list_id}/remove"
    payload = [ list_item.item_id ]     # book id, not list id
    response = s.post(url, json=payload)
    time.sleep(DELAY)
    assert response.json()["success"] == True

def add_list_item(s, list_info, list_item):
    # print(f"Adding item {list_item} to list {list_info}")
    url = f"https://catalog.fcpl.org/list/static/{list_info.list_id}/add"
    payload = [ list_item.item_id ]     # book id, not list id
    response = s.post(url, json=payload)
    time.sleep(DELAY)
    assert response.json()["success"] == True

def create_and_add(s, list_name, list_item):
    url = "https://catalog.fcpl.org/list/static"
    payload = {
        "scope": "Private",
        "name": list_name,
        "resourceIds": [ list_item.item_id ]
        }
    response = s.post(url, json=payload)
    time.sleep(DELAY)
    assert response.json()["success"] == True
    list_id = response.json()["id"]
    return ListInfo(list_name, list_id, 1)

def delete_list(s, list_info):
    url = "https://catalog.fcpl.org/lists/delete"
    payload = { "listIds": [list_info.list_id] }
    response = s.post(url, json=payload)
    time.sleep(DELAY)
    # slightly different response format
    assert response.json()[0]["success"] == True

# This API is a little whacked.  You can login in with either:
#   - barcode and last name, or
#   - username and password
# Why last name and password are separate fields but username
# and barcode use the same field I do not know.
def login(s, name_or_code, password):
    login_url = "https://catalog.fcpl.org/login"
    payload = {
        "username": name_or_code,
        "lastName": password,
        "rememberMe": False,
        "": "Cancel",
        "password": password
    }
    response = s.post(login_url, json=payload)
    time.sleep(DELAY)
    assert response.json()["success"] == True

def get_list_count(s):
    url = "https://catalog.fcpl.org/list/count/static"
    response = s.get(url)
    time.sleep(DELAY)
    return response.json()["count"]

def get_list_of_lists(s, count):
    url = f"https://catalog.fcpl.org/lists/static/0/{count}/Name"
    response = s.get(url)
    time.sleep(DELAY)
    return [ListInfo(item["name"], item["id"], item["resourceCount"])
            for item in response.json()]

def get_items_from_list(s, list_info):
    url = f"https://catalog.fcpl.org/list/static/{list_info.list_id}/0/{list_info.list_size}/Title"
    response = s.get(url)
    time.sleep(DELAY)
    list_of_resources = response.json()["resources"]
    return [ListItem.from_resource(resource) for resource in list_of_resources]

def get_loan_history(s):
    loan_list = []
    loans_per_page = 20
    start_index = 0
    there_is_more = True
    while there_is_more:
        url = f"https://catalog.fcpl.org/loans/history/page/{start_index}/{loans_per_page}/OutDate"
        time.sleep(DELAY)
        response = s.get(url)
        count = response.json()['count']
        start_index += loans_per_page
        if start_index >= count:
            there_is_more = False
        loans = response.json()['loans']
        
        for entry in loans:
            loan = entry['resource']
            if not loan:               # orphaned entry
                continue
            loan_list.append(ListItem.from_resource(loan))
            # print(".", end="", flush=True)
    return loan_list


def get_eresource_availability(s, id, host_bib_id):
    url = "https://catalog.fcpl.org/eResource/availability"
    payload = [ {
        "hostBibliographicId": host_bib_id,
        "resourceId": id,
        "useLoggedInUserCredentials": False
    } ]
    response = s.post(url, json=payload)
    time.sleep(DELAY)
    return response.json()

def get_resource(s, resource_id):
    url = f"https://catalog.fcpl.org/resource/{resource_id}"
    response = s.get(url)
    time.sleep(DELAY)
    return response.json()
